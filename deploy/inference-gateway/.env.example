# Copy to .env and replace with independent random values (24+ characters).
GATEWAY_CLIENT_TOKEN=replace-with-random-client-token-at-least-24-chars
GATEWAY_ADMIN_TOKEN=replace-with-random-admin-token-at-least-24-chars
BRIDGE_TOKEN=replace-with-random-bridge-token-at-least-24-chars
LUNA_BRIDGE_PORT=18765
LUNA_ENABLED=false
# Names, alias, and admin port can be overridden for an isolated CASES deployment.
GATEWAY_CONTAINER_NAME=ddu-gateway
GATEWAY_ADMIN_CONTAINER_NAME=ddu-gateway-admin
GATEWAY_NETWORK_ALIAS=ddu-gateway
GATEWAY_ADMIN_HOST_PORT=18766
GATEWAY_UPSTREAM_URL=http://ddu-gateway:8080
